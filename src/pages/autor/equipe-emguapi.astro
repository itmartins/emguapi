---
// src/pages/autor/equipe-emguapi.astro
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content'; 
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import NoticiaCard from '../../components/NoticiaCard.astro';
import AdBannerContainer from '../../components/ads/AdBannerContainer.astro';

// 1. Busca todas as notícias do banco
const todasNoticias = await getCollection('noticias');

// 2. Cria cópia destravada [...], filtra pelo autor e ordena
const ultimasNoticias = [...todasNoticias]
  .filter((n: CollectionEntry<'noticias'>) => !n.data.autor || n.data.autor === "Equipe emguapi")
  .sort((a: CollectionEntry<'noticias'>, b: CollectionEntry<'noticias'>) => new Date(b.data.data).getTime() - new Date(a.data.data).getTime())
  .slice(0, 6); 
---

<Layout 
  title="Equipe emguapi.com - Autores" 
  description="Conheça a equipe de redação oficial do portal emguapi.com. Cobertura completa, utilidade pública e jornalismo local sobre Guapimirim e região."
>
  <Navbar />
  
  <main class="max-w-5xl mx-auto px-6 py-12 md:py-20 transition-colors duration-300">
    
    {/* CABEÇALHO DO AUTOR */}
    <header class="flex flex-col md:flex-row items-center md:items-start gap-8 border-b border-gray-200 dark:border-white/10 pb-12">
      
      <div class="w-32 h-32 md:w-40 md:h-40 bg-navy-dark dark:bg-white/5 rounded-full flex items-center justify-center shrink-0 shadow-lg border-4 border-gray-50 dark:border-white/10 z-10 transition-transform hover:scale-105 duration-500">
        <span class="text-4xl md:text-5xl font-black text-white tracking-tighter">
          <span class="font-light">em</span><span class="text-red-base">G</span>
        </span>
      </div>

      <div class="text-center md:text-left flex-1">
        <div class="inline-block bg-red-base text-white text-[10px] font-black uppercase tracking-widest px-3 py-1.5 rounded-sm mb-4 shadow-sm">
          Redação Oficial
        </div>
        
        <h1 class="text-4xl md:text-5xl font-black uppercase tracking-tighter text-navy-dark dark:text-white mb-4 transition-colors">
          Equipe <span class="text-red-base">emguapi.com</span>
        </h1>
        
        <p class="text-gray-600 dark:text-gray-300 leading-relaxed text-base md:text-lg mb-8 max-w-2xl mx-auto md:mx-0 font-medium">
          Somos o núcleo de jornalismo do portal, dedicado a cobrir o dia a dia de Guapimirim e da Baixada Fluminense. Nosso foco é a utilidade pública, a fiscalização e a defesa dos interesses da população, desde o transporte até a cultura local.
        </p>
        
        <div class="flex flex-wrap gap-4 justify-center md:justify-start">
            
            {/* Botão de E-mail com Ícone SVG Profissional */}
            <a href="mailto:redacao@emguapi.com" class="group bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 text-navy-dark dark:text-white hover:border-navy-base dark:hover:border-white/30 px-6 py-3 rounded-md text-xs font-black uppercase tracking-widest transition-colors flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4 text-navy-base dark:text-gray-300 group-hover:scale-110 group-hover:text-red-base transition-all">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
              Enviar Pauta
            </a>
            
            {/* Botão de Voltar com Ícone SVG Animado */}
            <a href="/" class="group bg-navy-base text-white hover:bg-navy-dark dark:hover:bg-red-base px-6 py-3 rounded-md text-xs font-black uppercase tracking-widest transition-colors flex items-center gap-2.5 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 group-hover:-translate-x-1 transition-transform">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
              </svg>
              Voltar à Capa
            </a>

        </div>
      </div>
    </header>

    {/* LISTAGEM DE NOTÍCIAS */}
    <section class="mt-16">
      <h2 class="text-2xl font-black text-navy-dark dark:text-white uppercase tracking-tighter mb-10 flex items-center gap-3 border-b border-gray-100 dark:border-white/5 pb-4 transition-colors">
        <span class="w-2 h-6 bg-red-base inline-block rounded-sm"></span>
        Últimas reportagens
      </h2>
      
      {ultimasNoticias.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {ultimasNoticias.map((noticia: CollectionEntry<'noticias'>) => (
              <div class="h-full transform hover:-translate-y-1 transition-transform duration-300"> 
                  <NoticiaCard 
                      categoria={noticia.data.categoria}
                      titulo={noticia.data.titulo}
                      resumo={noticia.data.resumo || ""}
                      data={noticia.data.data}
                      link={`/noticias/${noticia.id.replace(/\.md$/, '')}`}
                      imagem={noticia.data.imagem || "/fotos/emguapi-capa.png"}
                  />
              </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-12 bg-gray-50 dark:bg-white/5 rounded-sm border border-gray-100 dark:border-white/10 flex flex-col items-center gap-4">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 text-gray-300 dark:text-gray-600">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
          <p class="text-gray-500 dark:text-gray-400 font-medium">Nenhuma reportagem recente encontrada para esta equipe.</p>
        </div>
      )}
    </section>

    {/* PUBLICIDADE HORIZONTAL */}
    <aside class="mt-16 pt-12 border-t border-gray-100 dark:border-white/10 flex flex-col items-center w-full">
        <span class="text-[9px] font-black text-gray-400 uppercase tracking-[0.3em] mb-4">Espaço Publicitário</span>
        <AdBannerContainer slotId="1504537360" format="horizontal" />
    </aside>

  </main>
</Layout>