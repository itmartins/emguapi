---
// src/pages/autor/vandira-evelyn.astro
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content'; // 1. Tipagem adicionada
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import NoticiaCard from '../../components/NoticiaCard.astro';
import AdBannerContainer from '../../components/ads/AdBannerContainer.astro';

// 2. Proteção contra o travamento do Array congelado
const todasNoticias = await getCollection('noticias');

const ultimasNoticias = [...todasNoticias]
  .filter((noticia: CollectionEntry<'noticias'>) => noticia.data.autor === 'Vandira Evelyn') 
  .sort((a: CollectionEntry<'noticias'>, b: CollectionEntry<'noticias'>) => new Date(b.data.data).getTime() - new Date(a.data.data).getTime())
  .slice(0, 6); // Aumentei para 6 para dar mais robustez ao portfólio dela
---

<Layout title="Vandira Evelyn - Colunista emguapi.com">
  <Navbar />
  
  <main class="max-w-5xl mx-auto px-6 py-12 md:py-20 transition-colors duration-300">
    
    {/* CABEÇALHO PREMIUM COM CONTRASTE */}
    <div class="bg-slate-50 dark:bg-[#112240] border border-slate-100 dark:border-white/10 rounded-3xl p-8 md:p-12 mb-16 shadow-sm relative overflow-hidden transition-colors duration-300">
      
      {/* Detalhe de iluminação sutil no fundo */}
      <div class="absolute top-0 right-0 w-64 h-64 bg-red-base/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4 pointer-events-none"></div>

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8 relative z-10">
        
        {/* Foto de perfil */}
        <div class="w-32 h-32 md:w-44 md:h-44 bg-white dark:bg-[#0a192f] rounded-full flex items-center justify-center shrink-0 shadow-md border-4 border-white dark:border-[#112240] overflow-hidden transition-transform hover:scale-105 duration-500">
          <img 
            src="/fotos/autores/vandira-evelyn.jpg" 
            alt="Vandira Evelyn" 
            class="w-full h-full object-cover" 
          />
        </div>

        <div class="text-center md:text-left flex-1">
          <div class="inline-block bg-red-base text-white text-[10px] font-black uppercase tracking-widest px-3 py-1.5 rounded-sm mb-4 shadow-sm">
            Colunista
          </div>
          
          <h1 class="text-4xl md:text-5xl font-black uppercase tracking-tighter text-navy-dark dark:text-white mb-4 transition-colors">
            Vandira <span class="text-red-base">Evelyn</span>
          </h1>
          
          <p class="text-slate-600 dark:text-gray-300 leading-relaxed text-base md:text-lg mb-6 max-w-2xl mx-auto md:mx-0 font-medium transition-colors">
            Advogada (OAB/RJ 232470) com atuação em Propriedade Intelectual e Direito Empresarial, dedicada à proteção de marcas, direitos autorais e ativos intelectuais. É vice-presidente da Comissão de Propriedade Intelectual da OAB Duque de Caxias e desenvolve conteúdos educativos voltados à democratização do conhecimento jurídico.
          </p>
          
          {/* 1. TAGS DE ESPECIALIDADE */}
          <div class="flex flex-wrap gap-2 justify-center md:justify-start mb-8">
            <span class="bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-500 dark:text-gray-400 text-[10px] md:text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full shadow-sm transition-colors">Propriedade Intelectual</span>
            <span class="bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-500 dark:text-gray-400 text-[10px] md:text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full shadow-sm transition-colors">Direito Empresarial</span>
            <span class="bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-500 dark:text-gray-400 text-[10px] md:text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full shadow-sm transition-colors">Economia Criativa</span>
          </div>

          {/* 2 & 3. BOTÕES COM ÍCONES PROFISSIONAIS */}
          <div class="flex flex-wrap gap-4 justify-center md:justify-start">
              <a href="https://vandiraevelyn.com.br/" target="_blank" rel="noopener noreferrer" class="group bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 text-navy-dark dark:text-white hover:border-slate-300 dark:hover:border-white/30 hover:bg-slate-100 dark:hover:bg-white/10 px-5 py-2.5 rounded-md text-xs font-black uppercase tracking-widest transition-all flex items-center gap-2 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-red-base group-hover:scale-110 transition-transform"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                Site Oficial
              </a>
              <a href="https://instagram.com/vandiraevelyn" target="_blank" rel="noopener noreferrer" class="group bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 text-navy-dark dark:text-white hover:border-slate-300 dark:hover:border-white/30 hover:bg-slate-100 dark:hover:bg-white/10 px-5 py-2.5 rounded-md text-xs font-black uppercase tracking-widest transition-all flex items-center gap-2 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-red-base group-hover:scale-110 transition-transform"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                Instagram
              </a>
              <a href="/" class="group bg-navy-dark text-white hover:bg-navy-base dark:hover:bg-red-base px-5 py-2.5 rounded-md text-xs font-black uppercase tracking-widest transition-all flex items-center gap-2 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                Voltar
              </a>
          </div>
        </div>
      </div>
    </div>

    <section>
      <h2 class="text-2xl font-black text-navy-dark dark:text-white uppercase tracking-tighter mb-10 flex items-center gap-3 border-b border-gray-100 dark:border-white/5 pb-4 transition-colors">
        <span class="w-2 h-6 bg-red-base inline-block rounded-sm"></span>
        Artigos Publicados
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {ultimasNoticias.length > 0 ? (
          ultimasNoticias.map((noticia: CollectionEntry<'noticias'>) => (
              <div class="h-full transform hover:-translate-y-1 transition-transform duration-300"> 
                  <NoticiaCard 
                      categoria={noticia.data.categoria}
                      titulo={noticia.data.titulo}
                      resumo=""
                      data={noticia.data.data}
                      link={`/noticias/${noticia.id.replace(/\.md$/, '')}`}
                      imagem={noticia.data.imagem || "/fotos/emguapi-capa.png"}
                  />
              </div>
          ))
        ) : (
          <div class="col-span-full bg-gray-50 dark:bg-white/5 rounded-xl p-8 text-center border border-dashed border-gray-200 dark:border-white/10 transition-colors">
            <p class="text-gray-500 dark:text-gray-400 font-medium">
              Os primeiros artigos da colunista serão publicados em breve.
            </p>
          </div>
        )}
      </div>
    </section>

    {/* PUBLICIDADE HORIZONTAL */}
    <aside class="mt-16 pt-12 border-t border-gray-100 dark:border-white/10 flex flex-col items-center w-full">
        <span class="text-[9px] font-black text-gray-400 uppercase tracking-[0.3em] mb-4">Espaço Publicitário</span>
        <AdBannerContainer slotId="1504537360" format="horizontal" />
    </aside>

  </main>
</Layout>