---
// src/pages/denuncia.astro
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content'; // 1. Importando a tipagem oficial
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import VozComunidade from '../components/VozComunidade.astro';
import NoticiaCard from '../components/NoticiaCard.astro';
import AdBannerContainer from '../components/ads/AdBannerContainer.astro';

// Busca todas as coleções
const noticias = await getCollection('noticias');
const denuncias = await getCollection('denuncias');

// Filtra APENAS as notícias que têm a categoria "Voz da Comunidade"
const noticiasVozDaComunidade = noticias.filter(
    (item: CollectionEntry<'noticias'>) => item.data.categoria === 'Voz da Comunidade'
);

// 2. Criamos um "Molde" perfeito para o TypeScript parar de reclamar (substitui o as any)
type ItemUnificado = 
  | { tipo: 'noticia'; id: string; slug: string; dataPostagem: number; dados: CollectionEntry<'noticias'>['data'] }
  | { tipo: 'denuncia_crua'; id: string; slug: string; dataPostagem: number; dados: CollectionEntry<'denuncias'>['data'] };

// 3. Unifica as duas listas de forma 100% segura
const todasAsDenuncias: ItemUnificado[] = [
    ...noticiasVozDaComunidade.map((item: CollectionEntry<'noticias'>) => ({
        tipo: 'noticia' as const,
        id: item.id,
        slug: item.id.replace(/\.md$/, ''), // Correção do Slug no Astro 7
        dataPostagem: new Date(item.data.data).getTime(),
        dados: item.data 
    })),
    ...denuncias.map((item: CollectionEntry<'denuncias'>) => ({
        tipo: 'denuncia_crua' as const,
        id: item.id,
        slug: item.id.replace(/\.md$/, ''), // Correção do Slug no Astro 7
        dataPostagem: new Date(item.data.data).getTime(),
        dados: item.data 
    }))
].sort((a, b) => b.dataPostagem - a.dataPostagem);

// Lista de bairros consolidada baseada no Ramal Guapimirim
const bairros = [ "Área Rural de Guapimirim", "Bananal", "Barreira", "Cadetes Fabres", "Caneca Fina", "Cantagalo", "Centro", "Citrolândia", "Corujas", "Cotia", "Espinhaço", "Garrafão", "Iconha", "Jardim Guapimirim", "Limoeiro", "Monte Oliveti", "Orindi", "Paiol", "Ideal", "Parque Santo Antônio (Modelo)", "Paraíso", "Parque Fleixal", "Parque Nossa Senhora da Ajuda", "Parque Santa Eugênia", "Parque Silvestre", "Quinta Mariana", "Quinta Rosângela", "Segredo", "Soberbo", "Vale das Pedrinhas", "Vale do Jequitibá", "Várzea Alegre", "Vila Olímpia" ];

const problemas = [ "Falta de Água", "Coleta de Lixo", "Iluminação Pública", "Problemas no Trem (Diesel)", "Segurança", "Buracos/Pavimentação" ];
---

<Layout 
    title="Voz da Comunidade - Denúncias | emguapi.com"
    description="Envie sua denúncia ou relato diretamente para a nossa redação. O canal de utilidade pública e fiscalização de Guapimirim."
>
    <Navbar />

    <main class="max-w-4xl mx-auto p-6 my-12 transition-colors duration-300">
        
        {/* CONTAINER DO FORMULÁRIO COM SUPORTE A DARK MODE */}
        <section class="bg-white dark:bg-[#1a2b4c] shadow-lg rounded-lg overflow-hidden border-t-8 border-red-base p-8 md:p-12 mb-20 border border-gray-200 dark:border-white/10 transition-colors duration-300">
            <header class="mb-10 text-center border-b border-gray-100 dark:border-white/10 pb-8 transition-colors">
                <h1 class="text-4xl font-black text-navy-dark dark:text-white uppercase tracking-tighter transition-colors">
                    Voz da <span class="text-red-base">Comunidade</span>
                </h1>
                <p class="text-navy-soft dark:text-gray-400 mt-2 font-medium transition-colors">O canal de utilidade pública de Guapimirim</p>
            </header>

            <form id="denuncia-form" class="space-y-6">
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-[10px] font-black uppercase text-navy-soft dark:text-gray-400 mb-2 tracking-widest transition-colors">Localidade</label>
                        <select id="bairro-form" required class="w-full bg-ice dark:bg-[#0a192f] text-navy-dark dark:text-white p-4 rounded-sm font-bold border border-gray-200 dark:border-white/10 focus:border-red-base dark:focus:border-red-400 outline-none transition-all cursor-pointer">
                            <option value="">Selecione o Bairro</option>
                            {bairros.map(b => <option value={b}>{b}</option>)}
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] font-black uppercase text-navy-soft dark:text-gray-400 mb-2 tracking-widest transition-colors">Assunto</label>
                        <select id="assunto-form" required class="w-full bg-ice dark:bg-[#0a192f] text-navy-dark dark:text-white p-4 rounded-sm font-bold border border-gray-200 dark:border-white/10 focus:border-red-base dark:focus:border-red-400 outline-none transition-all cursor-pointer">
                            <option value="">Tipo de Ocorrência</option>
                            {problemas.map(p => <option value={p}>{p}</option>)}
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-[10px] font-black uppercase text-navy-soft dark:text-gray-400 mb-2 tracking-widest transition-colors">Relato do Morador</label>
                    <textarea id="relato-form" rows="5" required placeholder="Descreva o problema com detalhes..." class="w-full bg-ice dark:bg-[#0a192f] text-navy-dark dark:text-white p-4 rounded-sm font-medium border border-gray-200 dark:border-white/10 focus:border-red-base dark:focus:border-red-400 outline-none resize-none transition-all"></textarea>
                </div>
                <div>
                    <label class="block text-[10px] font-black uppercase text-navy-soft dark:text-gray-400 mb-2 tracking-widest transition-colors">Seu Nome (Opcional)</label>
                    <input type="text" id="nome-form" placeholder="Ex: Dona Maria ou Morador do Centro" class="w-full bg-ice dark:bg-[#0a192f] text-navy-dark dark:text-white p-4 rounded-sm font-bold border border-gray-200 dark:border-white/10 focus:border-red-base dark:focus:border-red-400 outline-none transition-all" />
                </div>
                
                <button type="submit" class="w-full bg-navy-dark dark:bg-red-base hover:bg-red-base dark:hover:bg-red-700 text-white p-5 rounded-md font-black uppercase tracking-widest shadow-md transition-all transform hover:-translate-y-1 active:scale-95 flex items-center justify-center gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16"><path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592z"/></svg>
                    Enviar para a Redação no WhatsApp
                </button>
            </form>
            
            <div class="mt-8 p-4 bg-gray-50 dark:bg-white/5 rounded-sm border-l-4 border-navy-soft dark:border-gray-500 text-center transition-colors">
                <p class="text-[10px] text-navy-soft dark:text-gray-400 uppercase font-bold tracking-wider transition-colors">As denúncias são recebidas pela nossa equipe e podem ser transformadas em pautas jornalísticas.</p>
            </div>
        </section>

        <section>
            <h2 class="text-xl font-black uppercase tracking-tighter text-navy-dark dark:text-white mb-10 flex items-center gap-3 border-b border-gray-100 dark:border-white/10 pb-4 transition-colors">
                <span class="w-2 h-6 bg-red-base inline-block rounded-sm"></span>
                Relatos e Pautas Recentes
            </h2>

            <div id="denuncias-list" class="grid md:grid-cols-2 gap-6 mb-12">
                {todasAsDenuncias.length > 0 ? (
                    todasAsDenuncias.map((item, index) => (
                        <div class="denuncia-item transition-all duration-500" data-hidden={index >= 4 ? "true" : "false"}>
                            {item.tipo === 'noticia' ? (
                                <div class="h-full transform hover:-translate-y-1 transition-transform duration-300">
                                    <NoticiaCard 
                                        categoria={item.dados.categoria}
                                        titulo={item.dados.titulo}
                                        resumo={item.dados.resumo}
                                        data={item.dados.data}
                                        link={`/noticias/${item.slug}`}
                                        imagem={item.dados.imagem || "/fotos/estacao-guapi.jpg"}
                                    />
                                </div>
                            ) : (
                                <VozComunidade 
                                    bairro={item.dados.bairro}
                                    relato={item.dados.resumo_relato}
                                    autor={item.dados.autor}
                                />
                            )}
                        </div>
                    ))
                ) : (
                    <div class="col-span-2 bg-white dark:bg-[#1a2b4c] p-12 rounded-lg text-center border border-gray-100 dark:border-white/10 shadow-sm transition-colors">
                        <p class="text-navy-soft dark:text-gray-400 text-sm mb-4">Ainda não há relatos publicados.</p>
                    </div>
                )}
            </div>

            {todasAsDenuncias.length > 4 && (
                <div class="text-center pt-6 border-t border-gray-100 dark:border-white/10 transition-colors">
                    <button 
                        id="btn-carregar-mais"
                        class="group flex items-center gap-2 mx-auto text-xs font-black uppercase tracking-widest text-navy-base dark:text-white bg-white dark:bg-[#1a2b4c] border border-navy-base/20 dark:border-white/20 hover:border-navy-base/50 dark:hover:border-white/50 transition-all px-8 py-4 rounded-md shadow-sm"
                    >
                        Carregar mais relatos
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 group-hover:translate-y-1 transition-transform">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                        </svg>
                    </button>
                    <p id="msg-fim-lista" class="hidden text-[10px] font-black uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500 mt-6 transition-colors">
                        Todos os relatos foram exibidos.
                    </p>
                </div>
            )}
        </section>

        {/* PUBLICIDADE HORIZONTAL DO GOOGLE */}
        <div class="mt-16 pt-12 border-t border-gray-100 dark:border-white/10 flex flex-col items-center w-full transition-colors">
            <span class="text-[9px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-[0.3em] mb-4">Espaço Publicitário</span>
            <AdBannerContainer slotId="1504537360" format="horizontal" />
        </div>

    </main>
</Layout>

<style>
    .denuncia-item[data-hidden="true"] {
        display: none;
        opacity: 0;
        transform: translateY(20px);
    }
    .denuncia-item[data-hidden="false"] {
        display: block;
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    const form = document.getElementById('denuncia-form') as HTMLFormElement;
    if (form) {
        form.addEventListener('submit', (e: Event) => {
            e.preventDefault();
            const bairro = (document.getElementById('bairro-form') as HTMLSelectElement).value;
            const assunto = (document.getElementById('assunto-form') as HTMLSelectElement).value;
            const relato = (document.getElementById('relato-form') as HTMLTextAreaElement).value;
            const nome = (document.getElementById('nome-form') as HTMLInputElement).value || "Morador Anônimo";
            const mensagem = `📢 *DENÚNCIA - emguapi.com*%0A%0A*Local:* ${bairro}%0A*Assunto:* ${assunto}%0A*Relato:* ${relato}%0A%0A*Enviado por:* ${nome}`;
            window.open(`https://api.whatsapp.com/send?phone=21969400053&text=${mensagem}`, '_blank');
        });
    }

    const btnCarregarMais = document.getElementById('btn-carregar-mais');
    const msgFimLista = document.getElementById('msg-fim-lista');
    let itensVisiveis = 4; 
    const itensPorPagina = 4; 

    if (btnCarregarMais) {
        btnCarregarMais.addEventListener('click', () => {
            const itensEscondidos = document.querySelectorAll('.denuncia-item[data-hidden="true"]');
            const proximosItens = Array.from(itensEscondidos).slice(0, itensPorPagina);

            if (proximosItens.length === 0) {
                btnCarregarMais.classList.add('hidden'); 
                msgFimLista?.classList.remove('hidden'); 
                return;
            }

            proximosItens.forEach(item => {
                item.setAttribute('data-hidden', 'false');
            });

            itensVisiveis += proximosItens.length;
            if (document.querySelectorAll('.denuncia-item[data-hidden="true"]').length === 0) {
                btnCarregarMais.classList.add('hidden');
                msgFimLista?.classList.remove('hidden');
            }
        });
    }
</script>