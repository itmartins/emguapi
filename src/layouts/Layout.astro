---
// src/layouts/Layout.astro
import '../styles/global.css'; 

// Análise de acessos ao site (Vercel Analytics)
import Analytics from '@vercel/analytics/astro'

// IMPORTAR OS COMPONENTES
import Footer from '../components/Footer.astro'; 
import CookieConsent from '../components/CookieConsent.astro'; 

interface Props {
    title: string;
    description?: string;
    image?: string; 
    tags?: string[];
}

const { 
    title, 
    description = "Notícias, serviços e informações sobre Guapimirim e região.", 
    image = "/fotos/emguapi-capa.png",
    tags = []
} = Astro.props;

// Ajuste dinâmico e seguro do Link (Astro.site pega o domínio oficial configurado, ou usa o padrão)
const siteURL = Astro.site ? Astro.site.toString() : "https://www.emguapi.com"; 
const canonicalURL = new URL(Astro.url.pathname, siteURL).href;
const imageURL = new URL(image, siteURL).href;
---

<!doctype html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#112240" /> {/* Cor do topo do navegador no celular */}
        
        {/* SEO Básico & Canonical URL */}
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        {/* Fontes do Google otimizadas */}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">

        {/* Open Graph / Facebook / WhatsApp */}
        <meta property="fb:app_id" content="1506785261006656" />
        <meta property="og:type" content="article" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageURL} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:site_name" content="emguapi.com" />

        {/* Twitter */}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageURL} />

        {/* Tags da Reportagem */}
        {tags && tags.map(tag => (
            <meta property="article:tag" content={tag} />
        ))}

        {/* Google AdSense */}
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2720240238972537" crossorigin="anonymous"></script>

        {/* Google Analytics (GTAG) com Consentimento */}
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-FT7DRC4XE3"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}

            // Define o consentimento padrão como 'denied' (negado)
            gtag('consent', 'default', {
                'ad_storage': 'denied',
                'ad_user_data': 'denied',
                'ad_personalization': 'denied',
                'analytics_storage': 'denied'
            });

            gtag('js', new Date());
            gtag('config', 'G-FT7DRC4XE3');
        </script>
    </head>
    
    {/* Adicionado o dark:bg e dark:text para suportar o Modo Escuro no corpo todo */}
    <body class="bg-gray-50 dark:bg-[#0a192f] text-navy-base dark:text-gray-100 font-sans flex flex-col min-h-screen transition-colors duration-300">
        
        <div class="flex-grow">
            <slot />
        </div>
        
        <Footer />
        
        <CookieConsent />
        
        <Analytics />
        
        {/* SDK do Facebook */}
        <div id="fb-root"></div>
        <script async defer crossorigin="anonymous" src="https://connect.facebook.net/pt_BR/sdk.js#xfbml=1&version=v18.0"></script>
    </body>

    {/* PROTEÇÃO DE CONTEÚDO (ANTI-CÓPIA) */}
    <script>
        // Bloqueia o botão direito do mouse (menu de contexto)
        document.addEventListener('contextmenu', function(e) {
            e.preventDefault();
        });

        // Bloqueia atalhos de teclado usados para cópia e inspeção de código
        document.addEventListener('keydown', function(e) {
            // Bloqueia o F12 (Inspecionar)
            if (e.key === 'F12') {
                e.preventDefault();
            }
            // Bloqueia Ctrl+C, Ctrl+A, Ctrl+U, Ctrl+S, Ctrl+P
            if (e.ctrlKey && ['c', 'a', 'u', 's', 'p'].includes(e.key.toLowerCase())) {
                e.preventDefault();
            }
            // Bloqueia Ctrl+Shift+I, Ctrl+Shift+C, Ctrl+Shift+J
            if (e.ctrlKey && e.shiftKey && ['i', 'c', 'j'].includes(e.key.toLowerCase())) {
                e.preventDefault();
            }
        });
    </script>
</html>

<style is:global>
    /* ----------------------------------------- */
    /* AUTOMATIZAÇÃO DE CITAÇÕES (BLOCKQUOTE)    */
    /* ----------------------------------------- */
    
    .prose blockquote {
        border: none !important; 
        border-top: 1px solid #d1d5db !important; 
        border-bottom: 1px solid #d1d5db !important; 
        padding: 2.5rem 1rem !important; 
        margin: 3rem 0 !important; 
        position: relative;
        font-style: normal !important;
        color: #112240 !important; 
        font-size: 1.125rem !important; 
        font-weight: 700 !important; 
        line-height: 1.625 !important;
        text-align: center !important;
        background: transparent !important; 
        quotes: none !important;
    }

    /* Ajuste de cor da citação no modo escuro */
    html.dark .prose blockquote {
        color: #f3f4f6 !important; /* Texto claro no modo escuro */
        border-color: #374151 !important; /* Borda mais escura */
    }

    /* Remove as aspas automáticas feias do Tailwind */
    .prose blockquote p::before,
    .prose blockquote p::after {
        content: none !important;
        display: none !important;
    }

    /* Desenha a barrinha vermelha (cima) */
    .prose blockquote::before {
        content: "" !important;
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        width: 4rem !important; 
        height: 4px !important;
        background-color: #dc2626 !important; 
        top: -2.5px; 
    }

    /* Desenha a barrinha vermelha (baixo) */
    .prose blockquote::after {
        content: "" !important;
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        width: 4rem !important;
        height: 4px !important;
        background-color: #dc2626 !important;
        bottom: -2.5px; 
    }

    /* Remove margens extras do parágrafo de dentro */
    .prose blockquote p {
        margin: 0 !important;
    }
    
    /* ----------------------------------------- */
    /* BLOQUEIO DE SELEÇÃO E CÓPIA               */
    /* ----------------------------------------- */
    
    /* Bloqueia a seleção de texto (ficar azul) em todo o site */
    body {
        -webkit-user-select: none !important;
        -moz-user-select: none !important;
        -ms-user-select: none !important;
        user-select: none !important;
    }

    /* Impede o leitor de "arrastar" as imagens para a área de trabalho */
    img {
        -webkit-user-drag: none !important;
        -khtml-user-drag: none !important;
        -moz-user-drag: none !important;
        -o-user-drag: none !important;
    }
</style>