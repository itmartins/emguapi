---
// src/layouts/Layout.astro
import '../styles/global.css'; 

// Análise de acessos ao site (Vercel Analytics)
import Analytics from '@vercel/analytics/astro'

// IMPORTAR OS COMPONENTES
import Footer from '../components/Footer.astro'; 
import CookieConsent from '../components/CookieConsent.astro'; 

interface Props {
    title: string;
    description?: string;
    image?: string; 
    tags?: string[];
}

const { 
    title, 
    description = "Notícias, serviços e informações sobre Guapimirim e região.", 
    image = "/fotos/emguapi-capa.png",
    tags = []
} = Astro.props;

// Ajuste dinâmico e seguro do Link
const siteURL = Astro.site ? Astro.site.toString() : "https://www.emguapi.com"; 
const canonicalURL = new URL(Astro.url.pathname, siteURL).href;
const imageURL = new URL(image, siteURL).href;
---

<!doctype html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#112240" />
        
        {/* SEO Básico & Canonical URL */}
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        {/* Fontes do Google otimizadas */}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">

        {/* Open Graph / Facebook / WhatsApp */}
        <meta property="fb:app_id" content="1506785261006656" />
        <meta property="og:type" content="article" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageURL} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:site_name" content="emguapi.com" />

        {/* Twitter */}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageURL} />

        {/* Tags da Reportagem */}
        {tags && tags.map(tag => (
            <meta property="article:tag" content={tag} />
        ))}

        {/* Google Analytics (GTAG) com Consentimento */}
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-FT7DRC4XE3"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}

            // Define o consentimento padrão como 'denied' (negado)
            gtag('consent', 'default', {
                'ad_storage': 'denied',
                'ad_user_data': 'denied',
                'ad_personalization': 'denied',
                'analytics_storage': 'denied'
            });

            gtag('js', new Date());
            gtag('config', 'G-FT7DRC4XE3');
        </script>
    </head>
    
    <body class="bg-gray-50 dark:bg-[#0a192f] text-navy-base dark:text-gray-100 font-sans flex flex-col min-h-screen transition-colors duration-300">
        
        <div class="flex-grow">
            <slot />
        </div>
        
        <Footer />
        
        <CookieConsent />
        
        <Analytics />
        
        {/* SDK do Facebook */}
        <div id="fb-root"></div>
        <script async defer crossorigin="anonymous" src="https://connect.facebook.net/pt_BR/sdk.js#xfbml=1&version=v18.0"></script>

        {/* OTIMIZAÇÃO: Google AdSense Lazy Load (Só carrega quando rolar a tela) */}
        <script type="text/javascript">
          let adsLoaded = false;
          function loadGoogleAds() {
            if (!adsLoaded) {
              adsLoaded = true;
              const adScript = document.createElement('script');
              adScript.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2720240238972537";
              adScript.async = true;
              adScript.crossOrigin = "anonymous";
              document.head.appendChild(adScript);
              
              // Limpa os event listeners para não rodar duas vezes
              window.removeEventListener('scroll', loadGoogleAds);
              window.removeEventListener('mousemove', loadGoogleAds);
              window.removeEventListener('touchstart', loadGoogleAds);
            }
          }

          // Escuta a primeira interação do usuário (Descer a tela, mover o mouse ou tocar no celular)
          window.addEventListener('scroll', loadGoogleAds, { passive: true });
          window.addEventListener('mousemove', loadGoogleAds, { passive: true });
          window.addEventListener('touchstart', loadGoogleAds, { passive: true });

          // Se o usuário não fizer nada, o anúncio carrega de forma invisível após 3 segundos
          setTimeout(loadGoogleAds, 3000);
        </script>

        {/* PROTEÇÃO DE CONTEÚDO (ANTI-CÓPIA) */}
        <script is:inline>
            // Bloqueia o botão direito do mouse (menu de contexto)
            document.addEventListener('contextmenu', function(e) {
                e.preventDefault();
            });

            // Bloqueia atalhos de teclado usados para cópia e inspeção de código
            document.addEventListener('keydown', function(e) {
                if (e.key === 'F12') { e.preventDefault(); }
                if (e.ctrlKey && ['c', 'a', 'u', 's', 'p'].includes(e.key.toLowerCase())) { e.preventDefault(); }
                if (e.ctrlKey && e.shiftKey && ['i', 'c', 'j'].includes(e.key.toLowerCase())) { e.preventDefault(); }
            });
        </script>
    </body>
</html>

<style is:global>
    /* ----------------------------------------- */
    /* AUTOMATIZAÇÃO DE CITAÇÕES (BLOCKQUOTE)    */
    /* ----------------------------------------- */
    
    .prose blockquote {
        border: none !important; 
        border-top: 1px solid #d1d5db !important; 
        border-bottom: 1px solid #d1d5db !important; 
        padding: 2.5rem 1rem !important; 
        margin: 3rem 0 !important; 
        position: relative;
        font-style: normal !important;
        color: #112240 !important; 
        font-size: 1.125rem !important; 
        font-weight: 700 !important; 
        line-height: 1.625 !important;
        text-align: center !important;
        background: transparent !important; 
        quotes: none !important;
    }

    html.dark .prose blockquote {
        color: #f3f4f6 !important; 
        border-color: #374151 !important; 
    }

    .prose blockquote p::before,
    .prose blockquote p::after {
        content: none !important;
        display: none !important;
    }

    .prose blockquote::before {
        content: "" !important;
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        width: 4rem !important; 
        height: 4px !important;
        background-color: #dc2626 !important; 
        top: -2.5px; 
    }

    .prose blockquote::after {
        content: "" !important;
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        width: 4rem !important;
        height: 4px !important;
        background-color: #dc2626 !important;
        bottom: -2.5px; 
    }

    .prose blockquote p {
        margin: 0 !important;
    }
    
    /* ----------------------------------------- */
    /* BLOQUEIO DE SELEÇÃO E CÓPIA               */
    /* ----------------------------------------- */
    
    body {
        -webkit-user-select: none !important;
        -moz-user-select: none !important;
        -ms-user-select: none !important;
        user-select: none !important;
    }

    img {
        -webkit-user-drag: none !important;
        -khtml-user-drag: none !important;
        -moz-user-drag: none !important;
        -o-user-drag: none !important;
    }
</style>