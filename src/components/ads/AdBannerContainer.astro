---
interface Props {
  slotId: string;
  format?: 'horizontal' | 'rectangle';
}

const { slotId, format = 'horizontal' } = Astro.props;
const minHeightClass = format === 'rectangle' ? 'min-h-[250px]' : 'min-h-[90px]';
---

<div class={`w-full flex justify-center items-center my-6 bg-gray-50/50 rounded border border-gray-100 ${minHeightClass}`}>
  <ins
    class="adsbygoogle"
    style="display:block; width:100%;"
    data-ad-client="ca-pub-2720240238972537"
    data-ad-slot={slotId}
    data-ad-format="auto"
    data-full-width-responsive="true"
  ></ins>
</div>

<script is:inline>
  (adsbygoogle = window.adsbygoogle || []).push({});
</script>