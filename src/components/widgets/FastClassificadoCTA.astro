---
interface Props {
  whatsappNumber?: string;
}

const { whatsappNumber = '5521999999999' } = Astro.props; // Altere para o seu número

const message = encodeURIComponent(
  "Olá! Gostaria de cadastrar o meu comércio/serviço gratuitamente no Guia Comercial do emguapi.com.\n\n" +
  "Nome do Negócio:\n" +
  "Categoria:\n" +
  "Bairro:\n" +
  "Descrição curta:\n" +
  "Telefone/WhatsApp:"
);

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${message}`;
---

<div class="bg-emerald-50 border border-emerald-200 rounded-xl p-6 text-center my-8">
  <h3 class="text-xl font-bold text-emerald-900 mb-2">
    Tem um negócio em Guapimirim?
  </h3>
  <p class="text-sm text-emerald-700 mb-4 max-w-md mx-auto">
    Anuncie gratuitamente no nosso Guia Comercial e alcance moradores e visitantes da cidade.
  </p>
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-5 py-3 rounded-lg shadow transition-colors text-sm"
  >
    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
    </svg>
    Cadastrar Negócio de Graça
  </a>
</div>